ne","sourceColumn":"award_type","annotations":[{"name":"SummarizationSetBy","value":"Automatic"}]},{"name":"action_type_code","dataType":"string","lineageTag":"65d74a8d-a346-43a5-af9f-04d68fae4f62","summarizeBy":"none","sourceColumn":"action_type_code","annotations":[{"name":"SummarizationSetBy","value":"Automatic"}]},{"name":"action_type","dataType":"string","lineageTag":"d8f460fd-5005-4c9a-8221-304c4ee9a1f7","summarizeBy":"none","sourceColumn":"action_type","annotations":[{"name":"SummarizationSetBy","value":"Automatic"}]},{"name":"extent_competed","dataType":"string","lineageTag":"f4a3722e-eca7-4789-87a0-728604c653dc","summarizeBy":"none","sourceColumn":"extent_competed","annotations":[{"name":"SummarizationSetBy","value":"Automatic"}]},{"name":"naics_code","dataType":"string","lineageTag":"4ab32c7d-768a-4470-84ce-b5b5a04fdb30","summarizeBy":"none","sourceColumn":"naics_code","annotations":[{"name":"SummarizationSetBy","value":"Automatic"}]},{"name":"naics_description","dataType":"string","lineageTag":"854a3421-5a53-4e27-8136-bfc986ca8ac4","summarizeBy":"none","sourceColumn":"naics_description","annotations":[{"name":"SummarizationSetBy","value":"Automatic"}]},{"name":"product_or_service_code","dataType":"string","lineageTag":"ce0309e6-5529-4032-be69-d46d987c775f","summarizeBy":"none","sourceColumn":"product_or_service_code","annotations":[{"name":"SummarizationSetBy","value":"Automatic"}]},{"name":"product_or_service_code_description","dataType":"string","lineageTag":"98c1b2af-9b66-4e56-a26e-83e1d7d40a59","summarizeBy":"none","sourceColumn":"product_or_service_code_description","annotations":[{"name":"SummarizationSetBy","value":"Automatic"}]},{"name":"usaspending_permalink","dataType":"string","lineageTag":"b323fb1f-912e-4e8a-8c38-2b878d319d15","summarizeBy":"none","sourceColumn":"usaspending_permalink","annotations":[{"name":"SummarizationSetBy","value":"Automatic"}]}],"partitions":[{"name":"fct_contract_actions","mode":"import","source":{"type":"m","expression":"let\n    Source = GoogleBigQuery.Database([Implementation=\"2.0\"]),\n    #\"procurement-analysis-508918_Database\" = Source{[Name=\"procurement-analysis-508918\",Kind=\"Database\"]}[Data],\n    procurement_analytics_Schema = #\"procurement-analysis-508918_Database\"{[Name=\"procurement_analytics\",Kind=\"Schema\"]}[Data],\n    fct_contract_actions_Table = procurement_analytics_Schema{[Name=\"fct_contract_actions\",Kind=\"Table\"]}[Data]\nin\n    fct_contract_actions_Table"}}],"lineageTag":"62f9f72f-2b2a-4137-8b96-cbe149a5f3ce","measures":[{"name":"Model Total Actions","expression":"\nCOUNTROWS('fct_contract_actions')","formatString":"0","lineageTag":"e00486c9-d914-49c3-9764-790b5223b381"},{"name":"Model Funding Increases","expression":"\nCALCULATE(\n    SUM('fct_contract_actions'[obligation_amount]),\n    'fct_contract_actions'[obligation_amount] > 0\n)","formatString":"\\$#,0.00;(\\$#,0.00);\\$#,0.00","lineageTag":"46865d06-fe1b-4b67-8e58-3572cfab6992"},{"name":"Model Funding Reductions","expression":"\n-CALCULATE(\n    SUM('fct_contract_actions'[obligation_amount]),\n    'fct_contract_actions'[obligation_amount] < 0\n)","formatString":"\\$#,0.00;(\\$#,0.00);\\$#,0.00","lineageTag":"9659ab62-c692-4971-a585-cd9454a1b919"},{"name":"Model Net Obligations","expression":"\nSUM('fct_contract_actions'[obligation_amount])","formatString":"\\$#,0.00;(\\$#,0.00);\\$#,0.00","lineageTag":"91297060-57c6-4949-bdc4-abc3ed28d381"},{"name":"Model Top 5 Supplier Share","expression":"\nVAR SupplierFunding =\n    CALCULATETABLE(\n        ADDCOLUMNS(\n            FILTER(\n                'dim_supplier',\n                NOT ISBLANK('dim_supplier'[recipient_uei])\n            ),\n            \"@Funding\", [Model Funding Increases]\n        ),\n        REMOVEFILTERS('dim_supplier')\n    )\nVAR TopSuppliers =\n    TOPN(\n        5,\n        FILTER(SupplierFunding, [@Funding] > 0),\n        [@Funding], DESC,\n        'dim_supplier'[supplier_key], ASC\n    )\nVAR TotalFunding =\n    CALCULATE(\n        [Model Funding Increases],\n        REMOVEFILTERS('dim_supplier')\n    )\nRETURN\n    DIVIDE(\n        SUMX(TopSuppliers, [@Funding]),\n        TotalFunding\n    )","formatString":"0.00%;-0.00%;0.00%","lineageTag":"705ef878-27d0-47ec-a53a-835ea4dfd656"},{"name":"Model Top 10 Supplier Share","expression":"\nVAR SupplierFunding =\n    CALCULATETABLE(\n        ADDCOLUMNS(\n            FILTER(\n                'dim_supplier',\n                NOT ISBLANK('dim_supplier'[recipient_uei])\n            ),\n            \"@Funding\", [Model Funding Increases]\n        ),\n        REMOVEFILTERS('dim_supplier')\n    )\nVAR TopSuppliers =\n    TOPN(\n        10,\n        FILTER(SupplierFunding, [@Funding] > 0),\n        [@Funding], DESC,\n        'dim_supplier'[supplier_key], ASC\n    )\nVAR TotalFunding =\n    CALCULATE(\n        [Model Funding Increases],\n        REMOVEFILTERS('dim_supplier')\n    )\nRETURN\n    DIVIDE(\n        SUMX(TopSuppliers, [@Funding]),\n        TotalFunding\n    )","formatString":"0.00%;-0.00%;0.00%","lineageTag":"33e6d77b-0d17-4525-90cb-700e3ecbcb9b"},{"name":"Model Offer Count Coverage","expression":"\nDIVIDE(\n    COUNTROWS(\n        FILTER(\n            'fct_contract_actions',\n            NOT ISBLANK('fct_contract_actions'[number_of_offers_received])\n                && 'fct_contract_actions'[number_of_offers_received] >= 0\n        )\n    ),\n    [Model Total Actions]\n)","formatString":"0.00%;-0.00%;0.00%","lineageTag":"c960366c-64c1-41dd-909a-d4a93ec35164"},{"name":"Model Single Offer Share","expression":"\nDIVIDE(\n    CALCULATE(\n        [Model Total Actions],\n        'fct_contract_actions'[number_of_offers_received] = 1\n    ),\n    CALCULATE(\n        [Model Total Actions],\n        'fct_contract_actions'[number_of_offers_received] >= 1\n    )\n)","formatString":"0.00%;-0.00%;0.00%","lineageTag":"4b57dea9-9343-477c-9155-39ca5480ec95"},{"name":"Model Usable Offer Count Actions","expression":"\nCOUNTROWS(\n    FILTER(\n        'fct_contract_actions',\n        NOT ISBLANK('fct_contract_actions'[number_of_offers_received])\n            && 'fct_contract_actions'[number_of_offers_received] >= 0\n    )\n)","formatString":"0","lineageTag":"6e799dab-df2f-4f2b-b62b-6ed8a0b5d9f4"},{"name":"Prescriptive Offer Data Gap","expression":"\nVAR Rate = [Model Offer Count Coverage]\nRETURN IF(ISBLANK(Rate), BLANK(), 1 - Rate)","lineageTag":"1644cbba-819d-477c-b177-05921a5fd2ed","formatString":"0.00%;-0.00%;0.00%"},{"name":"Prescriptive Data Coverage Severity","expression":"\nVAR Actions = [Model Total Actions]\nVAR Coverage = [Model Offer Count Coverage]\nRETURN\nSWITCH(TRUE(),\n    Actions < 50 || ISBLANK(Coverage), 0,\n    Coverage < 0.35, 2,\n    Coverage < 0.70, 1,\n    0\n)","lineageTag":"41303e04-2805-4ced-b113-bccde3116939","formatString":"0"},{"name":"Prescriptive Single Offer Severity","expression":"\nVAR ActionsWithOffer = CALCULATE(\n    [Model Total Actions],\n    'fct_contract_actions'[number_of_offers_received] >= 1\n)\nVAR Coverage = [Model Offer Count Coverage]\nVAR SingleOffer = [Model Single Offer Share]\nRETURN\nSWITCH(TRUE(),\n    ActionsWithOffer < 50 || ISBLANK(SingleOffer) || Coverage < 0.70, 0,\n    SingleOffer >= 0.65, 2,\n    SingleOffer >= 0.50, 1,\n    0\n)","lineageTag":"8dcae638-659b-4af4-8b37-2c2d039f167b","formatString":"0"},{"name":"Prescriptive Supplier Severity","expression":"\nVAR Actions = [Model Total Actions]\nVAR Positive = [Model Funding Increases]\nVAR SupplierFunding =\n    SUMMARIZE(\n        FILTER('fct_contract_actions', 'fct_contract_actions'[obligation_amount] > 0),\n        'fct_contract_actions'[supplier_key],\n        \"@Positive\", SUM('fct_contract_actions'[obligation_amount])\n    )\nVAR Identified =\n    FILTER(SupplierFunding, 'fct_contract_actions'[supplier_key] <> \"unknown\" && [@Positive] > 0)\nVAR SupplierCount = COUNTROWS(Identified)\nVAR LargestShare = DIVIDE(MAXX(Identified, [@Positive]), Positive, 0)\nVAR UnknownShare = DIVIDE(\n    SUMX(FILTER(SupplierFunding, 'fct_contract_actions'[supplier_key] = \"unknown\"), [@Positive]),\n    Positive, 0\n)\nRETURN\nSWITCH(TRUE(),\n    Actions < 50 || Positive <= 0 || SupplierCount < 3 || UnknownShare > 0.20, 0,\n    LargestShare >= 0.50, 2,\n    LargestShare >= 0.35, 1,\n    0\n)","lineageTag":"107128ad-82c3-4840-a144-5af83ddba948","formatString":"0"},{"name":"Prescriptive Funding Severity","expression":"\nVAR Actions = [Model Total Actions]\nVAR Positive = [Model Funding Increases]\nVAR Ratio = DIVIDE([Model Funding Reductions], Positive, 0)\nRETURN\nSWITCH(TRUE(),\n    Actions < 50 || Positive <= 0, 0,\n    Ratio >= 0.40, 2,\n    Ratio >= 0.20, 1,\n    0\n)","lineageTag":"51bb990d-4bed-41a0-a463-49dd1d7912a4","formatString":"0"},{"name":"Prescriptive Review Priority","expression":"\nVAR DataSignal = [Prescriptive Data Coverage Severity]\nVAR OfferSignal = [Prescriptive Single Offer Severity]\nVAR SupplierSignal = [Prescriptive Supplier Severity]\nVAR FundingSignal = [Prescriptive Funding Severity]\nVAR Highest = MAX(MAX(DataSignal, OfferSignal), MAX(SupplierSignal, FundingSignal))\nRETURN SWITCH(Highest, 2, \"HIGH\", 1, \"MEDIUM\", \"MONITOR\")","lineageTag":"bad06744-175b-4b2a-825a-ead6c2b6abd6"},{"name":"Prescriptive Primary Signal","expression":"\nVAR DataSignal = [Prescriptive Data Coverage Severity]\nVAR OfferSignal = [Prescriptive Single Offer Severity]\nVAR SupplierSignal = [Prescriptive Supplier Severity]\nVAR FundingSignal = [Prescriptive Funding Severity]\nVAR Highest = MAX(MAX(DataSignal, OfferSignal), MAX(SupplierSignal, FundingSignal))\nRETURN\nSWITCH(TRUE(),\n    Highest = 0, \"No threshold triggered\",\n    DataSignal = Highest, \"Offer data completeness\",\n    OfferSignal = Highest, \"Single-offer review\",\n    SupplierSignal = Highest, \"Supplier concentration\",\n    FundingSignal = Highest, \"Funding adjustments\",\n    \"No threshold triggered\"\n)","lineageTag":"4d1a25b1-ff08-459b-8c10-887ad28c9192"},{"name":"Prescriptive Recommended Next Step","expression":"\nSWITCH([Prescriptive Primary Signal],\n    \"Offer data completeness\", \"Audit missing offer counts and validate reporting fields\",\n    \"Single-offer review\", \"Sample awards; check solicitation and competition context\",\n    \"Supplier concentration\", \"Review supplier categories, contracts and alternatives\",\n    \"Funding adjustments\", \"Reconcile high-value modifications with finance\",\n    \"Monitor; no rule-triggered review\"\n)","lineageTag":"2fa50f51-f6f8-4d82-865e-75d8f63c2f6d"}]}],"relationships":[{"name":"2a1b88e7-4a3c-4e62-a134-793573d6d3f4","fromTable":"dim_date","fromColumn":"date_key","toTable":"LocalDateTable_686ba2c0-74fc-4c8d-a1d2-12fade15a5fd","toColumn":"Date","crossFilteringBehavior":"oneDirection","isActive":true,"joinOnDateBehavior":"datePartOnly"},{"name":"AutoDetected_1a5f7b86-98ed-49d5-bb8e-bc35d1776213","fromTable":"fct_contract_actions","fromColumn":"agency_key","toTable":"dim_agency","toColumn":"agency_key","crossFilteringBehavior":"oneDirection","isActive":true},{"name":"AutoDetected_6263cf8a-b073-4d94-868d-45cb77d04c60","fromTable":"fct_contract_actions","fromColumn":"supplier_key","toTable":"dim_supplier","toColumn":"supplier_key","crossFilteringBehavior":"oneDirection","isActive":true},{"name":"e3e2cdb3-47fb-b1f6-156b-4c1ca8550fa4","fromTable":"fct_contract_actions","fromColumn":"date_key","toTable":"dim_date","toColumn":"date_key","crossFilteringBehavior":"oneDirection","isActive":true}],"annotations":[{"name":"__PBI_TimeIntelligenceEnabled","value":"1"},{"name":"PBI_QueryOrder","value":"[\"dim_date\",\"dim_agency\",\"dim_supplier\",\"fct_contract_actions\"]"}]}}